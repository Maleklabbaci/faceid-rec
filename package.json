{
  "name": "faceid-platform-cloudflare",
  "private": true,
  "description": "FaceID Platform — Cloudflare Pages edition (static site + Functions + D1). Local dev & tests only; nothing to build.",
  "scripts": {
    "dev": "wrangler pages dev site --d1 DB=faceid --port 8788 --ip 0.0.0.0",
    "test": "node --test tests/cloudflare.test.mjs",
    "test:unit": "node --test tests/binding.test.mjs",
    "test:ui": "node --test tests/ui-flow.test.mjs",
    "test:all": "node --test tests/binding.test.mjs tests/cloudflare.test.mjs tests/ui-flow.test.mjs tests/kiosk-ui.test.mjs",
    "deploy": "wrangler pages deploy site --project-name saaspromax",
    "test:kiosk": "node --test tests/kiosk-ui.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "wrangler": "^4.0.0"
  }
}
