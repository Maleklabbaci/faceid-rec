# Copier ce fichier en .env puis remplir les deux valeurs marquées OBLIGATOIRE.
# .env n'est jamais committé (il est dans .gitignore) : il contient des secrets.

# OBLIGATOIRE — signe les cookies de session. Une clé perdue = tout le monde déconnecté.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# OBLIGATOIRE pour `docker compose` — jeton du tunnel Cloudflare
# (Zero Trust → Networks → Tunnels → votre tunnel → Copy token)
CLOUDFLARE_TUNNEL_TOKEN=

# Optionnel ---------------------------------------------------------------
# Où poser la base SQLite. Dans le conteneur, laisser /data (volume persistant).
#WEB_DATABASE=/data/web.db

# Cookie de session : le défaut « auto » suit le schéma de chaque requête
# (Secure en HTTPS, sans flag en HTTP local — sinon le navigateur jette le cookie
# et la connexion boucle sur /login). Forcer seulement si besoin.
#COOKIE_SECURE=1

# Derrière Cloudflare Tunnel / Nginx : prend le vrai IP client (limites de tentatives)
#TRUST_PROXY=1

# Charger le moteur facial au démarrage (à combiner avec gunicorn --preload)
#PRELOAD_FACE=1

# Démonstration dans l'iframe d'un autre site : SameSite=None; Secure + framing autorisé.
# Ne jamais activer en production.
#EMBED_PREVIEW=1

# Édition Cloudflare Pages (functions/) : le secret PEPPER se règle dans le tableau de
# bord Pages → Settings → Functions → Secrets, pas ici.
