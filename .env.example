# Copy to .env (never commit .env). Generate the key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-64-hex-characters
# Token shown by Cloudflare Zero Trust > Networks > Tunnels > your tunnel (starts with "eyJ")
CLOUDFLARE_TUNNEL_TOKEN=
# Number of gunicorn workers (each loads the face engine, ~300 MB RAM per worker)
WEB_CONCURRENCY=2
